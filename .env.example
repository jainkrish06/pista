# ---------------------------------------------------------------------------
# PISTA environment configuration template.
# Copy to .env (root, for docker-compose) and to apps/server/.env and
# apps/web/.env.local as needed. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://pista:pista_dev_password@localhost:5432/pista?schema=public"

# --- Redis (matchmaking queue, rate limiting). Optional in dev: falls back
# to an in-memory queue when unset, but Redis is required in production. ---
REDIS_URL="redis://localhost:6379"

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- WebRTC / TURN ------------------------------------------------------------
# OPTIONAL / PRODUCTION: a local coturn instance is fine for dev; a real TURN
# provider (or your own coturn deployment) is needed for production, since
# some users are behind symmetric NATs where direct P2P will fail.
TURN_SERVER_URL="turn:localhost:3478"
TURN_USERNAME=""
TURN_PASSWORD=""
NEXT_PUBLIC_STUN_SERVER="stun:stun.l.google.com:19302"

# --- Admin ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
ADMIN_SECRET="replace-with-a-long-random-string"

# --- Misc ------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
WEB_APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"

# OPTIONAL / PRODUCTION - bot/abuse protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
